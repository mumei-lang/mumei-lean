# Lake / Lean build artefacts
/.lake/
/examples/lean_cli/.lake/
/build/
/out/
*.olean
*.ilean
*.hash

# Generated Lean sources from mumei .proof-cert.json.
# The namespace root (`generated/Generated.lean`) IS committed so
# `lake build` can resolve the `Generated` lib on a fresh checkout;
# the ingested submodules under `generated/Generated/` are not.
/generated/*
!/generated/Generated.lean

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Automatic tactic search probe modules (scripts/tactic_search.py)
/.tactic_search/
